list(LENGTH discovered_tests test_count)
if(NOT test_count EQUAL 4)
    message(FATAL_ERROR "Expected four discovered tests, got ${test_count}")
endif()
foreach(expected "alpha;beta" "regular" "two;;semicolons" "comma,semi;colon")
    list(FIND discovered_tests "${expected}" index)
    if(index EQUAL -1)
        message(FATAL_ERROR "Test name was not preserved: ${expected}")
    endif()
endforeach()
